{
  "name": "Rate Gap Dark",
  "dataColors": [
    "#38BDF8",
    "#F59E0B",
    "#14B8A6",
    "#EF4444",
    "#818CF8",
    "#22C55E"
  ],
  "background": "#0F172A",
  "foreground": "#F8FAFC",
  "tableAccent": "#1E293B",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "transparency": 0
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "position": "Outer"
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#334155"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 35,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#334155"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#243247"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    }
  },
  "textClasses": {
    "callout": {
      "fontSize": 35,
      "fontFace": "Segoe UI Semibold",
      "color": "#F8FAFC"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#F8FAFC"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#F8FAFC"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#CBD5E1"
    }
  },
  "foregroundNeutralSecondary": "#CBD5E1",
  "backgroundLight": "#1E293B"
}